## Copy to android/keystore.properties (gitignored) and fill in real values
## before running `npm run app:publish`. Without this file, release builds
## fall back to debug signing and publish-app.mjs will refuse to publish.
MOVIX_RELEASE_STORE_FILE=movix-release.jks
MOVIX_RELEASE_STORE_PASSWORD=changeme
MOVIX_RELEASE_KEY_ALIAS=movix
MOVIX_RELEASE_KEY_PASSWORD=changeme
