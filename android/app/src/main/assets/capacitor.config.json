{
	"appId": "fr.movix.app",
	"appName": "Movix",
	"webDir": "dist",
	"server": {
		"androidScheme": "https",
		"hostname": "movix.app",
		"cleartext": true,
		"allowNavigation": [
			"*"
		]
	},
	"android": {
		"allowMixedContent": true,
		"backgroundColor": "#0f0f0f",
		"loggingBehavior": "none"
	},
	"ios": {
		"backgroundColor": "#0f0f0f",
		"contentInset": "automatic"
	}
}
