{
  "name": "pc_dawger",
  "version": "1.0.4",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.tonsite.pcdawger",
    "productName": "PC Dawger",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.ico"
    },
    "portable": {
      "artifactName": "PCDawger-portable.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "PCDawger-Setup.exe"
    },
    "extraResources": [
      {
        "from": "../dist",
        "to": "frontend"
      },
      {
        "from": "../API/Mainapi",
        "to": "backend",
        "filter": [
          "**/*",
          "!node_modules/**",
          "!data/**",
          "!tests/**",
          "!logs/**",
          "!*.log",
          "!*.md"
        ]
      },
      {
        "from": "../API/Mainapi/node_modules",
        "to": "backend/node_modules",
        "filter": [
          "**/*",
          "!@ffmpeg-installer/**",
          "!better-sqlite3/**",
          "!sqlite3/**",
          "!openai/**",
          "!node-gyp/**"
        ]
      }
    ]
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3"
  }
}
